#!/usr/bin/env -S env NIXPKGS_ALLOW_UNFREE=1 nix
#! nix develop --impure --expr ``(let cwd = builtins.getEnv "PWD"; home = builtins.getEnv "HOME"; pin = (builtins.getFlake "path:${home}/.dotfiles/nixpkgs-pin/.config/nixpkgs-pin").inputs.nixpkgs; aiJail = builtins.getFlake "github:akitaonrails/ai-jail/v3.5.0"; flake = builtins.getFlake "git+file:${cwd}"; system = builtins.currentSystem; pkgs = import pin { inherit system; config.allowUnfree = true; }; in pkgs.mkShell { inputsFrom = [ flake.devShells.${system}.default ]; packages = [ pkgs.git pkgs.bash pkgs.claude-code pkgs.eza aiJail.packages.${system}.default ]; })`` --command bash

# nix develop creates a new tempdir but inside ai-jail it is /tmp
export TMPDIR=/tmp


ai-jail --worktree --rw-map /home/eike/.claude --ro-map /nix --ro-map /run --env PATH claude
